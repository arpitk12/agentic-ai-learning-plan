# Copy this file to .env and fill in your values.
# Only ONE MODEL line should be active at a time.
# See FREE_CLOUD_LLM.md for full provider details and week-by-week recommendations.

# ── LOCAL (Ollama — no API key needed) ────────────────────────────────────────
# Install: brew install ollama && ollama pull llama3.2 && ollama serve
MODEL=ollama/llama3.2
# MODEL=ollama/qwen2.5:7b        ← best local tool-calling (Weeks 2-5)
# MODEL=ollama/mistral            ← fast, good general reasoning

# ── FREE CLOUD — Groq (no credit card) ─────────────────────────────────────────
# Sign up: https://console.groq.com
# MODEL=groq/llama-3.3-70b-versatile   ← best all-round free model ⭐
# MODEL=groq/qwen-qwq-32b              ← best reasoning (Week 9)
# MODEL=groq/llama3-8b-8192            ← fastest, good for evals (Week 10)
# GROQ_API_KEY=gsk_...

# ── FREE CLOUD — Google Gemini (no credit card) ────────────────────────────────
# Sign up: https://aistudio.google.com
# MODEL=gemini/gemini-2.0-flash        ← huge context, great for RAG (Week 4) ⭐
# MODEL=gemini/gemini-1.5-pro
# GEMINI_API_KEY=AIza...

# ── FREE CLOUD — Cerebras (no credit card) ─────────────────────────────────────
# Sign up: https://cloud.cerebras.ai
# MODEL=cerebras/llama3.1-70b          ← extremely fast (Week 6 parallelism)
# CEREBRAS_API_KEY=csk_...

# ── FREE CLOUD — OpenRouter (free models, no credit card) ─────────────────────
# Sign up: https://openrouter.ai
# MODEL=openrouter/mistralai/mistral-7b-instruct:free
# MODEL=openrouter/meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_API_KEY=sk-or-...

# ── PAID CLOUD (uncomment when ready) ─────────────────────────────────────────
# MODEL=anthropic/claude-haiku-4-5-20251001
# MODEL=anthropic/claude-sonnet-4-5
# MODEL=gpt-4o-mini
# MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Other API Keys ─────────────────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...              ← for web search tool (Project 1)
# GITHUB_TOKEN=ghp_...                 ← for PR fetcher (Project 3)
