# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── Redis (rate limiting + semantic cache) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Model Configuration ───────────────────────────────────────────────────
LLM_PRIMARY=openai/gpt-4o-mini
LLM_FALLBACK=openai/gpt-3.5-turbo
LLM_FINE_TUNED=                     # e.g. openai/ft:gpt-3.5-turbo:your-org:model-id:xxx
LLM_VISION=openai/gpt-4o            # must support vision

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Mem0 ──────────────────────────────────────────────────────────────────────
# Leave blank to use local in-memory (Qdrant embedded)
MEM0_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
API_RATE_LIMIT_RPM=60

# ── Guardrails ────────────────────────────────────────────────────────────────
# Set to 1 to use LlamaGuard (requires GPU). Set to 0 for GPT-4o-mini fallback.
USE_LLAMA_GUARD=0
