# LLM Backend
MODEL=gpt-4o-mini
LITELLM_API_BASE=http://localhost:4000

# Observability — choose one or both
# Langfuse (open-source, self-hostable)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (LangChain ecosystem)
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=compliance-review
LANGCHAIN_TRACING_V2=true

# AWS AgentCore (for production compliance runtime)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AGENTCORE_AGENT_ID=agent-xxxxxxxxxxxx

# Google Vertex AI (for analytics-heavy workloads)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Storage
CHECKPOINT_DB=data/compliance_checkpoints.db
AUDIT_FILE=data/audit_trail.jsonl

# Business parameters (for cost reporting)
ANALYST_HOURLY_RATE=85
MANUAL_HOURS_PER_DOC=5
