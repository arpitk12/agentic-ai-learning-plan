# LLM — pick one provider (see FREE_CLOUD_LLM.md at repo root)
MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your_gemini_key_here
# GROQ_API_KEY=your_groq_key_here
# MODEL=groq/llama-3.3-70b-versatile

# Embedding model (sentence-transformers — runs locally, no API key needed)
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384

# Vector store — local persistent (default, no Docker needed)
CHROMA_PATH=./data/chroma_db
COLLECTION_NAME=prod_rag

# Vector store — HTTP mode (used when running with docker-compose)
# CHROMA_HOST=chromadb
# CHROMA_PORT=8001

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
TOP_K=6
RERANK_TOP_N=3
BM25_WEIGHT=0.3

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Evaluation
EVAL_PASS_THRESHOLD=0.75

# Data
DATA_DIR=data/sample_docs
