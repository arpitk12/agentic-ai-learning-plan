# ── LLM ──────────────────────────────────────────────────────────────────
MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=your_key_here
# or: OPENAI_API_KEY / GROQ_API_KEY / ANTHROPIC_API_KEY

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_docs
QDRANT_USE_GRPC=false          # set true in production for lower latency

# ── Kafka ────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_QUERY_CACHE_TTL=3600       # seconds — 1 hour
REDIS_EMBED_CACHE_TTL=86400      # seconds — 24 hours

# ── Caching thresholds ───────────────────────────────────────────────────
SEMANTIC_CACHE_THRESHOLD=0.97    # cosine similarity for semantic cache hit
SEMANTIC_CACHE_SIZE=5000         # max entries in semantic cache

# ── Retrieval ────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20               # candidates fetched before reranking
RERANKER_TOP_N=5                 # kept after reranking

# ── Zero-hallucination thresholds ────────────────────────────────────────
NLI_MODEL=cross-encoder/nli-deberta-v3-base
FAITHFULNESS_THRESHOLD=0.75      # per-sentence entailment threshold
OVERALL_FAITHFULNESS_THRESHOLD=0.80   # min fraction of grounded sentences
MIN_RETRIEVAL_SCORE=0.65         # abstain if max cosine sim < this

# ── Embedding ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=60
